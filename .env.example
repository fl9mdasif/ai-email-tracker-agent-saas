# Auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Database (Neon)
DATABASE_URL=

# Encryption (32-byte hex string: openssl rand -hex 32)
CREDENTIALS_ENCRYPTION_KEY=

# OpenAI
OPENAI_API_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Inngest ailab.provider
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Neon, pulled by `neon env pull`)
DATABASE_URL_UNPOOLED=

# Language model (the model name is swappable; default is a small, cheap one)
LLM_MODEL=gpt-4.1-mini
